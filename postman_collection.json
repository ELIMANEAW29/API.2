{
  "info": {
    "name": "API REST utilisateurs",
    "description": "Requetes CRUD pour tester l'API Express et Mongoose.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "userId",
      "value": "REMPLACER_PAR_UN_ID"
    }
  ],
  "item": [
    {
      "name": "GET - Tous les utilisateurs",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/users"
      }
    },
    {
      "name": "POST - Creer un utilisateur",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Amira Diallo\",\n  \"email\": \"amira@example.com\",\n  \"age\": 28\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/users"
      }
    },
    {
      "name": "PUT - Modifier un utilisateur",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"age\": 29\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/users/{{userId}}"
      }
    },
    {
      "name": "DELETE - Supprimer un utilisateur",
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/api/users/{{userId}}"
      }
    }
  ]
}